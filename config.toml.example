# claude-gateway local config.
#
# Loaded by `config::File::with_name("config")` at startup from the
# gateway's working directory (set by the launchd plist to
# ~/workspace/withAI/claude-gateway). Required = false, so this file
# is purely override-on-top-of-defaults.
#
# Sections omitted = defaults (see src/config.rs).

[proxy]
# Concurrent /v1/messages calls allowed through the upstream Anthropic
# semaphore. Default in code is 1 ("conservative"); raising it lets
# parallel measurement workloads (G2-A-LLM 24-case batches, future
# committee dispatch through gateway) finish faster — Claude Code
# itself uses the same OAuth token for multiple concurrent sessions,
# so 1 OAuth × N concurrent is the demonstrated-supported pattern.
#
# Start at 4 (matches typical Claude Code session count); raise to 8
# if Anthropic doesn't 429 and 4 is still the bottleneck.
max_concurrent = 4

[server]
# Browser origins allowed to call this gateway. Matched exactly, except that a
# bare host also covers any port on it (`http://localhost` admits
# `http://localhost:5173`). The scheme is part of an origin, so `https://` needs
# its own entry, and a path (`/chat`) never matches — browsers don't send one.
#
# An empty list refuses every cross-origin browser caller. curl and
# server-to-server callers are unaffected either way; CORS is a browser rule.
cors_origins = ["http://localhost", "http://127.0.0.1"]

# Serve every origin. The gateway has no authentication of its own, so this
# lets any page the user visits spend their Claude subscription and — with
# permission_mode: bypassPermissions — run commands on this host. Deliberately
# something you type rather than something an empty list gives you.
# cors_allow_any_origin = true

# Allow cookies and HTTP auth on cross-origin requests. Needed when something
# in front of the gateway authenticates with a cookie, which is the only
# credential EventSource can carry. Cannot be combined with
# cors_allow_any_origin — browsers reject that pairing.
# cors_allow_credentials = true
